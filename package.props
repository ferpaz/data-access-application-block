<Project>
	<Import Project="version.props" />

	<PropertyGroup>
		<Version>$(MajorVersion).$(MinorVersion).$(ReleaseVersion)</Version>
		<PreAssemblyName>Microsoft.Practices.EnterpriseLibrary</PreAssemblyName>
		<PrePackageName>EnterpriseLibrary</PrePackageName>
		<PostPackageName>.NetCore</PostPackageName>
		<PackageReleaseNotes>Targets .NET Framework 4.8, .NET Standard 2.0, .NET 8 and .NET 10. SQL Server uses Microsoft.Data.SqlClient on all targets; migrating from System.Data.SqlClient can require configuration and code changes. See the project documentation for migration guidance.</PackageReleaseNotes>

		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<PackageVersion>$(Version)$(SemanticVersionSuffix)</PackageVersion>
		<Authors>Enterprise Library Open Source Project</Authors>
		<Copyright>Copyright © Microsoft 2008, Enterprise Library Open Source Project 2017</Copyright>
		<PackageIcon>entlib_new_icon_100x100.png</PackageIcon>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/EnterpriseLibrary/data-access-application-block</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

		<RepositoryUrl>https://github.com/ferpaz/data-access-application-block</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<OutputPath>$(SolutionDir)..\bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\..\entlib_new_icon_100x100.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<OracleManagedDataAccessCore>2.18.151</OracleManagedDataAccessCore>
		<SystemConfigurationConfigurationManagerVersion>4.6.0</SystemConfigurationConfigurationManagerVersion>
		<SystemDataSqlClientVersion>4.8.6</SystemDataSqlClientVersion>
		<MicrosoftDataSqlClientVersion>4.0.5</MicrosoftDataSqlClientVersion>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Set EntLibDependencyType=Project to use the sibling Common checkout. -->
		<EntLibDependencyType Condition="'$(EntLibDependencyType)' == ''">Package</EntLibDependencyType>
        <EntLibCommon Condition="'$(EntLibCommon)' == ''">$(MSBuildThisFileDirectory)..\common-infrastructure\source\Src\Common\Common.csproj</EntLibCommon>
		<EntLibCommonVersion>6.3.0</EntLibCommonVersion>
	</PropertyGroup>

  <Target Name="ValidateEntLibDependency" BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild">
    <Error Condition="'$(EntLibDependencyType)' != 'Package' and '$(EntLibDependencyType)' != 'Project'" Text="EntLibDependencyType must be Package or Project; received '$(EntLibDependencyType)'." />
    <Error Condition="'$(EntLibDependencyType)' == 'Project' and !Exists('$(EntLibCommon)')" Text="Common project not found at '$(EntLibCommon)'. Set EntLibCommon to the Common.csproj path." />
  </Target>
</Project>
